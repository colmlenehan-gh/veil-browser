{
  "name": "veil-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --no-experimental-require-module --test tests/*.test.js",
    "test:live": "node tests/live.js",
    "test:ui": "node tests/ui.js",
    "build": "node scripts/build.mjs",
    "postinstall": "npm run build",
    "pretest": "npm run build",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "iconv-lite": "0.7.2",
    "ipaddr.js": "2.2.0",
    "playwright-core": "1.65.0",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "sanitize-html": "2.18.2"
  },
  "engines": {
    "node": "24.x"
  }
}

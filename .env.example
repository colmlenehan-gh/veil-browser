# Set these in Vercel project settings; never commit values.
VEIL_API_ORIGIN=https://your-project.vercel.app
VEIL_ALLOWED_ORIGINS=https://colmlenehan-gh.github.io,https://your-project.vercel.app
VEIL_ACCESS_KEY=
VEIL_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public preview: short-lived origin/client-bound browser sessions.
# Set VEIL_ACCESS_KEY instead to require a private owner key.
VEIL_GUEST_ACCESS=1
# Vercel Marketplace may provision KV_REST_API_URL and KV_REST_API_TOKEN.
